        "mean_offset_s": 0.019048,
        "max_offset_s": 0.107143,
        "n_participants_pass": 15,
        "n_participants_fail": 0,
        "threshold_pass": true,
        "note": "12/15 participants: zero residual. S2/S3/S4: residuals up to 0.107 s, within the E4 EDA quantisation bound of +/-0.125 s. All 15 participants pass the 1.0 s threshold."
