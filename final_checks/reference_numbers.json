        "value_s": 1181.2,
        "range_s": {
          "min": 920.0,
          "max": 1416.0
        },
        "interpretation": "The ~19-minute gap is a sensor activation-window difference: the E4 wristband activates ~15-24 minutes before the RespiBAN chest sensor. This is resolved by trimming to the shared overlap window. It is NOT a residual the threshold measures.",
        "threshold_pass": null,
        "threshold_applies": false,
        "note": "Threshold does not apply to the raw start-time gap."
      },
      "after": {
        "state": "within_overlap_residual",
