.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Raw and derived dataset files — stored on disk but must never leave this machine
# (data access agreements cover both raw and cleaned participant physiological data).
# Exclude everything in bronze/ and silver/ except .gitkeep placeholders.
bronze/*
!bronze/.gitkeep
silver/*
!silver/.gitkeep
archive.zip
archive_DEAP.zip
archive_DEAP_v1.zip
archive_DEAP_V2.zip
bronze/DEAP/
handoff/
TRM_Assessment_2_Final.pdf
*.pptx
docs/sources/
deap/docs/sources/*.pdf
.venv_verify/

# Experiment scratch space -- contains participant data copies; never commit
# (harness writes to system temp, but these entries stay as a safeguard)
experiments/scratch/
experiments/scratch_dirty/
wesad/experiments/scratch/
wesad/experiments/scratch_dirty/

# Local tooling files, not part of the project
docs/archive/
OneDrive.lnk
